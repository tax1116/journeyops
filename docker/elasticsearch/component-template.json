{
  "template": {
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "match_only_text" },
        "service": { "properties": { "name": { "type": "keyword" } } },
        "event": {
          "properties": {
            "id": { "type": "keyword" },
            "action": { "type": "keyword" },
            "dataset": { "type": "keyword" },
            "duration": { "type": "long" },
            "outcome": { "type": "keyword" }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "id": { "type": "keyword" },
                "method": { "type": "keyword" }
              }
            },
            "response": { "properties": { "status_code": { "type": "integer" } } }
          }
        },
        "trace": { "properties": { "id": { "type": "keyword" } } },
        "span": { "properties": { "id": { "type": "keyword" } } },
        "user": { "properties": { "id": { "type": "keyword" } } },
        "loan": { "properties": { "application": { "properties": { "id": { "type": "keyword" } } } } },
        "error": { "properties": { "code": { "type": "keyword" } } },
        "custom": { "type": "flattened" }
      }
    },
    "settings": {
      "index.number_of_shards": 1
    }
  }
}
